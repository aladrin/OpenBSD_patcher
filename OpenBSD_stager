#!/bin/ksh
SCRIPT=${0##*/}
HOST=$(uname -n)
REV=$(uname -r)
ARCH=$(uname -m)
SIZE=4096
STAGE_HOST=$1
shift
mkdir -p /usr/xenocara
ssh $STAGE_HOST OpenBSD_ramdisk on $HOST $REV $ARCH $SIZE && {
  MOUNTS="/usr/src /usr/obj /usr/xenocara /usr/xobj"
  for i in $MOUNTS; do
    mount_nfs -T -r 32768 -w 32768 $STAGE_HOST:/misc/$(echo $i|sed "s/\/usr/$REV.$ARCH/") $i || { echo ${SCRIPT}: nfs mount of $i failed; exit 1; }
  done
  STAGE_HOST=$STAGE_HOST $@
  RC=$?
  sleep 2
  for i in $MOUNTS; do
    umount $i
  done
  ssh $STAGE_HOST OpenBSD_ramdisk off $HOST $REV $ARCH $SIZE || echo ${SCRIPT}: $STAGE_HOST off script failed
  exit $RC
} || echo ${SCRIPT}: $STAGE_HOST on script failed
